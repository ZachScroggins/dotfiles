      // Correct black
      "terminal.ansiBrightBlack": "#44403c",

      // Text selection
      "editor.selectionBackground": "#007acc",
      "editor.selectionHighlightBackground": "#ADD6FF26",
      "editor.inactiveSelectionBackground": "#007acc",

      // Find results
      "editor.findMatchBackground": "#fa05",
      "editor.findMatchHighlightBackground": "#fa05",
      "editor.findMatchBorder": "#fe000000",
      "editor.findMatchHighlightBorder": "#ADD6FF26",
      "editor.selectionHighlightBorder": "#ADD6FF00",

      // Borders
      "sideBar.border": "#222",
      "editorGroup.border": "#222",
      "editorIndentGuide.background": "#222", // Indent lines
      "editorIndentGuide.activeBackground": "#333", // Active indent line

      "tab.activeBorder": "#fff"
    },
    "[Night Owl]": {
      "activityBar.background": "#000C1D",
      "activityBar.border": "#102a44",
      "sideBar.background": "#001122",
      "sideBar.border": "#102a44",
      "sideBar.foreground": "#8BADC1"
    },
    "[Night Owl No Italics]": {
      "activityBar.background": "#000C1D",
      "activityBar.border": "#102a44",
      "sideBar.background": "#001122",
      "sideBar.border": "#102a44",
      "sideBar.foreground": "#8BADC1"
    }
  },
  // Pitch black - Title bar (Allow the title bar to be styled by the color theme)
  "window.titleBarStyle": "custom",
  // Pitch plack - Hide border next to scroll bar that separates panes
  "editor.overviewRulerBorder": false,
  "editor.tokenColorCustomizations": {
    "[Cyberpunk]": {
      "textMateRules": [
        {
          "scope": [
            "keyword.operator.new",
            "keyword.operator.expression",
            "keyword.operator.cast",
            "keyword.operator.sizeof",
            "keyword.operator.logical.python",
            "emphasis",
            "entity.other.attribute-name",
            "markup.italic",
            "storage.modifier",
            "entity.name.function",
            "entity.name.method",
            "meta.function",
            "meta.function-call",
            "variable.parameter",
            "variable.other",
            "meta.var.expr",
            "constant.language"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "variable.other.readwrite",
            "meta.tag",
            "storage.type",
            "keyword.control"
          ],
          "settings": {
            "fontStyle": ""
          }
        },
        {
          "name": "String interpolation",
          "scope": [
            "punctuation.definition.template-expression.begin",
            "punctuation.definition.template-expression.end",
            "punctuation.section.embedded"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "name": "this.self",
          "scope": "variable.language",
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "name": "@Decorator",
          "scope": ["meta.decorator punctuation.decorator"],
          "settings": {
            "fontStyle": "italic"
          }
        }
      ]
    },
