    "terminalCursor.foreground": "#00faac",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiBlue": "#00bfff",
    "terminal.ansiBrightBlack": "#000000",
    "terminal.ansiBrightBlue": "#1bccfd",
    "terminal.ansiBrightCyan": "#99d6fc",
