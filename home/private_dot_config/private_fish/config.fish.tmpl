# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:{{ .chezmoi.homeDir }}/.docker/bin"
# End of Docker Desktop section.

if status is-interactive
    # Commands to run in interactive sessions can go here
end

set -gx EDITOR nvim

set fish_color_autosuggestion DFAFFF --underline

# --- Aliases ---------------------------------------------------------------
alias vim=nvim
alias tmux="tmux -2"
alias ls="eza --git"
alias la="eza -la --git"
alias brewbackup="brew bundle dump --force --file=$HOME/Brewfile"
alias brewupgrade="brew update && brew upgrade && brew bundle dump --force --file=$HOME/Brewfile"
alias npmbackup="npm ls -g --depth 0 > $HOME/globalnpmpackages.txt"
alias resource="exec fish -l" # fresh login shell: reloads .zprofile and .zshrc
alias pi4="ssh zach@192.168.1.192"
alias pi3="ssh zach@192.168.1.127"

# --- Node (fnm) ------------------------------------------------------------
eval "$(fnm env --use-on-cd --shell fish)"

# --- Claude Code: GitHub MCP token only for claude, not every process -------
function claude
    GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token)" command claude $argv
end

# keep at end
starship init fish | source
