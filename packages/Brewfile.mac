# Brewfile.mac: macOS-only. GUI apps (casks), fonts, VS Code extensions and
# language-level packages (cargo/uv/npm). install-mac.sh installs Node (fnm)
# and Rust (rustup) first so the cargo/npm lines work on a fresh Mac.

tap "manaflow-ai/cmux"
# CD/DVD/Blu-ray premastering and recording software
brew "cdrtools"
# User-friendly command-line shell for UNIX-like operating systems
brew "fish"

# Nerd Fonts used by Ghostty/starship (were installed by hand, not in ~/Brewfile)
cask "font-sauce-code-pro-nerd-font"
cask "font-fira-code-nerd-font"
# Image editing and design software
cask "affinity"
# Tools for building Android applications
cask "android-studio"
# Chromium-based web browser with a vertical tab sidebar
cask "ardia"
# Computer-aided design and drafting tool
cask "cadcraft"
# OpenAI's official ChatGPT desktop app
cask "chatgpt"
# Anthropic's official Claude AI desktop app
cask "claude"
# Terminal-based AI coding assistant
cask "claude-code"
# Ghostty-based terminal with vertical tabs and notifications for AI coding agents
cask "cmux"
# Background desktop automation driver for AI agents
cask "cuadriver"
# Presentation editor
cask "deckcraft"
# Voice and text chat software
cask "discord"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Motion graphics and visual effects compositor
cask "effectcraft"
# Launch builds and start simulators from your menu bar
cask "expo-orbit"
# Video editor
cask "filmcraft"
# Web browser
cask "firefox"
# Offline voice-to-text dictation app with AI enhancement
cask "fluidvoice"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Web browser
cask "google-chrome"
# Spreadsheet editor
cask "gridcraft"
# Terminal emulator as alternative to Apple's Terminal app
cask "iterm2"
# Photo library manager and raw image developer
cask "lightcraft"
# Discover, download, and run local LLMs
cask "lm-studio"
# Software for Logitech devices
cask "logi-options+"
# File system integration
cask "macfuse"
# Multi-platform web browser
cask "microsoft-edge"
# App to write, plan, collaborate, and get organised
cask "notion"
# Open-source software for live streaming and screen recording
cask "obs"
# Knowledge base that works on top of a local folder of plain text Markdown files
cask "obsidian"
# PDF editor
cask "pdfcraft"
# Administration and development platform for PostgreSQL
cask "pgadmin4"
# Image editor
cask "photocraft"
# Collaboration platform for API development
cask "postman"
# VPN client focusing on security
cask "protonvpn"
# Imaging utility to install operating systems to a microSD card
cask "raspberry-pi-imager"
# Digital audio workstation
cask "soundcraft"
# Tool to render realistic skies in real time on the screen
cask "stellarium"
# PDF utility
cask "stirling-pdf"
# Mesh VPN based on WireGuard
cask "tailscale-app"
# Vector editor
cask "vectorcraft"
# Disk encryption software focusing on security based on TrueCrypt
cask "veracrypt"
# Open-source code editor
cask "visual-studio-code"
# Menu bar toolkit with keep-awake, system monitor and volume mixer
cask "vorssaint"
# Word processor
cask "wordcraft"
# Video communication and virtual meeting platform
cask "zoom"

